{
	"schemaVersion": 1,
	"id": "quality",
	"version": "${version}",
	"name": "Quality",
	"description": "This mod adds the quality enchantment, which allows finding resources of higher quality. Use the new ingredients to craft better tools and furnaces!",
	"authors": [
		"Saurerstoff"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/quality/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"saurerstoff.quality.Quality"
		],
		"client": [
			"saurerstoff.quality.QualityClient"
		],
		"fabric-datagen": [
			"saurerstoff.quality.docs.datagen.QualityDataGenerator"
		]
	},
	"mixins": [
		"quality.mixins.json",
		{
			"config": "quality.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}